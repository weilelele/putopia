# ─────────────────────────────────────────────────────────────────────────────
# Local development environment — copy this file to `.env.local` and fill in.
#
#   cp .env.local.example .env.local
#
# Only the REQUIRED block is needed to boot the app. Everything else is
# feature-scoped: if a key is missing, that feature degrades gracefully (the
# code checks for the key and no-ops) — it will NOT crash `npm run dev`.
#
# In production these are set in the Vercel project settings, not in this file.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED — the app can't auth or read/write data without these ═══════════

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser. Server-side only.
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ═══ OPTIONAL — public site URL ══════════════════════════════════════════════
# Used to build absolute links (emails, redirects). Falls back to the
# production domain (https://multiverseco.org) when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ═══ OPTIONAL — payments (voyager-pack checkout) ═════════════════════════════
# Checkout is hidden/disabled unless both the secret and price are present.
# Use TEST keys locally — preview/prod share LIVE Stripe (see AGENTS.md).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...


# ═══ OPTIONAL — AI studio (/studio image+text generation) ════════════════════
ANTHROPIC_API_KEY=sk-ant-...


# ═══ OPTIONAL — analytics (PostHog) ══════════════════════════════════════════
# Client-side capture:
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side funnel snapshot cron (/api/analytics/snapshot):
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com


# ═══ OPTIONAL — Cosmo media catalog (MongoDB, signal-tasks browser) ══════════
COSMO_MONGO_URI=mongodb+srv://...


# ═══ OPTIONAL — email / newsletter ═══════════════════════════════════════════
# Transactional email (Resend):
RESEND_API_KEY=re_...
RESEND_FROM=Putopia <hello@multiverseco.org>
# Newsletter subscribe on application (Beehiiv):
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# Contact/marketing sync (Loops):
LOOPS_API_KEY=
# Where world-confirmed alert emails go:
ALERT_EMAIL=


# ═══ OPTIONAL — automation / cron ════════════════════════════════════════════
# Shared secret guarding cron + admin invite endpoints (Authorization header).
CRON_SECRET=
# Wiki sync (/api/wiki/sync) pushes docs to a GitHub wiki repo:
GITHUB_WIKI_REPO=owner/repo.wiki
GITHUB_WIKI_TOKEN=
