{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core",
    "storyEngine",
    "confirmed",
    "estimates",
    "unresolved",
    "phases",
    "votes",
    "atmosphere",
    "boundaries",
    "nextQuestions"
  ],
  "properties": {
    "core": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "storyEngine": { "type": "string", "minLength": 1 },
    "confirmed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "label", "purpose", "beats", "gate"],
        "properties": {
          "number": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "beats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "votes": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "whyNow", "options", "fixed", "result"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "whyNow": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "fixed": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "atmosphere": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nextQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
